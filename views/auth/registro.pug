extends ../layout/auth
include ../mixins/campo

block contenido
  h1(class="font-display text-4xl") Crea tu cuenta
  p(class="mt-2 text-bosque-900/60") Publica y encuentra propiedades en minutos.

  form(method="POST" action="/auth/registro" class="mt-10 space-y-5" novalidate)
    //- Token CSRF: protege el formulario de envíos desde otros sitios
    input(type="hidden" name="_csrf" value=csrfToken)
    +alerta()
    +campo("nombre", "Nombre", "text", "Tu nombre", "name")
    +campo("email", "Email", "email", "ejemplo@correo.com", "email")
    +campo("password", "Password", "password", "Mínimo 6 caracteres", "new-password")
    +campo("repetir_password", "Repetir password", "password", "Repite tu password", "new-password")

    div(class="pt-2")
      +boton("Crear cuenta")

  p(class="mt-8 text-center text-sm text-bosque-900/60")
    | ¿Ya tienes cuenta? #[a(href="/auth/login" class="font-semibold text-terracota-600 hover:underline") Inicia sesión]
