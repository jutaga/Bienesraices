extends ../layout/auth
include ../mixins/campo

//- Recibe del controlador:
//-   errores -> [{ path: "email", msg: "..." }] (campo) o [{ msg: "..." }] (general)
//-   mensaje -> texto de éxito cuando se enviaron las instrucciones
//-   email   -> (opcional) dirección a la que se envió el correo
block contenido
  if mensaje && !errores
    //- Éxito: se reemplaza el formulario por la confirmación
    div(class="text-center" role="status")
      div(class="mx-auto flex size-16 items-center justify-center rounded-full bg-bosque-50 text-bosque-700 ring-8 ring-bosque-50/50")
        svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-8" aria-hidden="true")
          path(stroke-linecap="round" stroke-linejoin="round" d="M21.75 9v.906a2.25 2.25 0 0 1-1.183 1.981l-6.478 3.488M2.25 9v.906a2.25 2.25 0 0 0 1.183 1.981l6.478 3.488m8.839 2.51-4.66-2.51m0 0-1.023-.55a2.25 2.25 0 0 0-2.134 0l-1.022.55m0 0-4.661 2.51m16.5 1.615a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V8.844a2.25 2.25 0 0 1 1.183-1.981l7.5-4.039a2.25 2.25 0 0 1 2.134 0l7.5 4.039a2.25 2.25 0 0 1 1.183 1.98V19.5Z")

      h1(class="mt-8 font-display text-4xl") Revisa tu email
      p(class="mt-4 text-bosque-900/70")= mensaje

      if email
        p(class="mt-6 inline-block rounded-full bg-arena-100 px-4 py-2 text-sm font-semibold text-bosque-800")= email

      p(class="mt-6 text-sm text-bosque-900/50") Si no lo ves en unos minutos, revisa tu carpeta de spam.

    div(class="mt-10 space-y-3")
      a(href="/auth/login" class="group flex w-full items-center justify-center gap-2 rounded-full bg-bosque-900 px-6 py-3.5 font-semibold text-arena-50 transition hover:bg-bosque-800 focus:outline-none focus:ring-4 focus:ring-bosque-900/20")
        | Volver a iniciar sesión
        span(class="transition-transform group-hover:translate-x-1" aria-hidden="true") →
      a(href="/auth/olvide-password" class="flex w-full items-center justify-center rounded-full border border-bosque-900/15 px-6 py-3.5 font-semibold text-bosque-900 transition hover:bg-arena-100") Enviar de nuevo

  else
    h1(class="font-display text-4xl") Recupera tu acceso
    p(class="mt-2 text-bosque-900/60") Escribe tu email y te enviaremos las instrucciones para crear una nueva password.

    form(method="POST" action="/auth/olvide-password" class="mt-10 space-y-5" novalidate)
      //- Token CSRF: protege el formulario de envíos desde otros sitios
      input(type="hidden" name="_csrf" value=csrfToken)
      //- Error: alerta roja arriba + campo marcado en rojo con su mensaje
      +alerta()
      +campo("email", "Email", "email", "ejemplo@correo.com", "email")

      div(class="pt-2")
        +boton("Enviar instrucciones")

    p(class="mt-8 text-center text-sm text-bosque-900/60")
      | ¿Ya la recordaste? #[a(href="/auth/login" class="font-semibold text-terracota-600 hover:underline") Inicia sesión]
