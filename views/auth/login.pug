extends ../layout/auth
include ../mixins/campo

block contenido
  h1(class="font-display text-4xl") Bienvenido de nuevo
  p(class="mt-2 text-bosque-900/60") Ingresa tus datos para acceder a tu cuenta.

  form(method="POST" action="/auth/login" class="mt-10 space-y-5" novalidate)
    //- Token CSRF: protege el formulario de envíos desde otros sitios
    input(type="hidden" name="_csrf" value=csrfToken)
    +alerta()
    +campo("email", "Email", "email", "ejemplo@correo.com", "email")
    +campo("password", "Password", "password", "Tu password", "current-password")

    div(class="flex justify-end")
      a(href="/auth/olvide-password" class="text-sm font-medium text-bosque-900/60 hover:text-terracota-600 hover:underline") ¿Olvidaste tu contraseña?

    div(class="pt-2")
      +boton("Iniciar sesión")

  p(class="mt-8 text-center text-sm text-bosque-900/60")
    | ¿No tienes cuenta? #[a(href="/auth/registro" class="font-semibold text-terracota-600 hover:underline") Crea una]
