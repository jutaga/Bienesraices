extends ../layout/auth
include ../mixins/campo

//- Crear una nueva contraseña desde el enlace del email
//- Recibe del controlador:
//-   csrfToken -> token CSRF del formulario
//-   errores   -> [{ path: "password", msg: "..." }] (campo) o [{ msg: "..." }] (general)
//-   mensaje   -> texto de éxito cuando la contraseña se guardó
//-   error     -> true si el token del enlace no es válido
block contenido
  if error
    //- Enlace inválido o ya usado
    div(class="text-center" role="alert")
      div(class="mx-auto flex size-16 items-center justify-center rounded-full bg-error-50 text-error-500 ring-8 ring-error-50/50")
        svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-8" aria-hidden="true")
          path(stroke-linecap="round" stroke-linejoin="round" d="M13.181 8.68a4.503 4.503 0 0 1 1.903 6.405m-9.768-2.782L3.56 14.06a4.5 4.5 0 0 0 6.364 6.365l3.129-3.129m5.614-5.615 1.757-1.757a4.5 4.5 0 0 0-6.364-6.365l-4.5 4.5c-.258.26-.479.541-.661.84m1.903 6.405a4.495 4.495 0 0 1-1.242-.88 4.483 4.483 0 0 1-1.062-1.683m6.587 2.345 5.907 5.907m-5.907-5.907L8.898 8.898M2.991 2.99 8.898 8.9")

      h1(class="mt-8 font-display text-4xl") Enlace no válido
      p(class="mt-4 font-medium text-error-600")= mensaje || "Este enlace ya se usó o está incompleto."
      p(class="mt-4 text-sm text-bosque-900/60") Por seguridad, cada enlace solo sirve una vez. Pide uno nuevo para crear tu contraseña.

    div(class="mt-10 space-y-3")
      a(href="/auth/olvide-password" class="group flex w-full items-center justify-center gap-2 rounded-full bg-bosque-900 px-6 py-3.5 font-semibold text-arena-50 transition hover:bg-bosque-800 focus:outline-none focus:ring-4 focus:ring-bosque-900/20")
        | Pedir un enlace nuevo
        span(class="transition-transform group-hover:translate-x-1" aria-hidden="true") →
      a(href="/auth/login" class="flex w-full items-center justify-center rounded-full border border-bosque-900/15 px-6 py-3.5 font-semibold text-bosque-900 transition hover:bg-arena-100") Volver a iniciar sesión

  else if mensaje && !errores
    //- Éxito: contraseña actualizada
    div(class="text-center" role="status")
      div(class="mx-auto flex size-16 items-center justify-center rounded-full bg-bosque-50 text-bosque-700 ring-8 ring-bosque-50/50")
        svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-8" aria-hidden="true")
          path(stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z")

      h1(class="mt-8 font-display text-4xl") Contraseña actualizada
      p(class="mt-4 text-bosque-900/70")= mensaje

    div(class="mt-10")
      a(href="/auth/login" class="group flex w-full items-center justify-center gap-2 rounded-full bg-bosque-900 px-6 py-3.5 font-semibold text-arena-50 transition hover:bg-bosque-800 focus:outline-none focus:ring-4 focus:ring-bosque-900/20")
        | Iniciar sesión
        span(class="transition-transform group-hover:translate-x-1" aria-hidden="true") →

  else
    //- Formulario (sin action: se envía a la misma URL, que ya incluye el token)
    h1(class="font-display text-4xl") Crea una nueva contraseña
    p(class="mt-2 text-bosque-900/60") Elige una contraseña que no hayas usado antes. Debe tener al menos 6 caracteres.

    form(method="POST" class="mt-10 space-y-5" novalidate)
      //- Token CSRF: protege el formulario de envíos desde otros sitios
      input(type="hidden" name="_csrf" value=csrfToken)
      +alerta()
      +campo("password", "Nueva contraseña", "password", "Mínimo 6 caracteres", "new-password")
      +campo("repetir_password", "Repetir contraseña", "password", "Repite tu nueva contraseña", "new-password")

      div(class="pt-2")
        +boton("Guardar contraseña")

    p(class="mt-8 text-center text-sm text-bosque-900/60")
      | ¿Ya la recordaste? #[a(href="/auth/login" class="font-semibold text-terracota-600 hover:underline") Inicia sesión]
