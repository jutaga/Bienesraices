//- Cabecera del área de administración
//- Se incluye desde layout/admin.pug (vistas que hacen extends ../layout/admin)
//- Usa:
//-   pagina    -> para marcar el enlace activo ("Mis propiedades" / "Crear propiedad")
//-   csrfToken -> para el formulario de cerrar sesión (POST /auth/cerrar-sesion)
- const enlaces = [{ texto: "Mis propiedades", href: "/mis-propiedades" }, { texto: "Publicar propiedad", href: "/propiedades/crear", pagina: "Crear propiedad" }]

header(class="bg-white")
  //- Fila superior: logo, etiqueta de panel y cerrar sesión
  div(class="border-b border-arena-200")
    div(class="container mx-auto flex items-center justify-between gap-4 px-4 py-5")
      div(class="flex items-center gap-3")
        a(href="/mis-propiedades" class="font-display text-2xl") Bienes#[span(class="text-terracota-500") Raíces]
        span(class="hidden rounded-full bg-arena-100 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-bosque-900/60 sm:inline") Panel

      form(method="POST" action="/auth/cerrar-sesion")
        input(type="hidden" name="_csrf" value=locals.csrfToken)
        button(type="submit" class="inline-flex cursor-pointer items-center gap-2 rounded-full px-4 py-2 text-sm font-medium text-bosque-900/70 transition hover:bg-arena-100 hover:text-bosque-900")
          svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4" aria-hidden="true")
            path(fill-rule="evenodd" clip-rule="evenodd" d="M3 4.25A2.25 2.25 0 0 1 5.25 2h5.5A2.25 2.25 0 0 1 13 4.25v2a.75.75 0 0 1-1.5 0v-2a.75.75 0 0 0-.75-.75h-5.5a.75.75 0 0 0-.75.75v11.5c0 .414.336.75.75.75h5.5a.75.75 0 0 0 .75-.75v-2a.75.75 0 0 1 1.5 0v2A2.25 2.25 0 0 1 10.75 18h-5.5A2.25 2.25 0 0 1 3 15.75V4.25Z")
            path(fill-rule="evenodd" clip-rule="evenodd" d="M19 10a.75.75 0 0 0-.75-.75H8.704l1.048-.943a.75.75 0 1 0-1.004-1.114l-2.5 2.25a.75.75 0 0 0 0 1.114l2.5 2.25a.75.75 0 1 0 1.004-1.114l-1.048-.943h9.546A.75.75 0 0 0 19 10Z")
          | Cerrar sesión

  //- La barra: navegación del panel
  nav(class="bg-bosque-900" aria-label="Panel de administración")
    div(class="container mx-auto flex gap-1 overflow-x-auto px-4")
      each enlace in enlaces
        - const activo = locals.pagina === (enlace.pagina || enlace.texto)
        a(
          href=enlace.href
          aria-current=(activo ? "page" : undefined)
          class=(activo ? "whitespace-nowrap border-b-2 border-terracota-400 px-4 py-3.5 text-sm font-semibold text-arena-50" : "whitespace-nowrap border-b-2 border-transparent px-4 py-3.5 text-sm font-medium text-arena-200/70 transition hover:text-arena-50")
        )= enlace.texto
