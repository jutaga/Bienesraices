extends ../layout/admin

//- Panel "Mis propiedades"
//- Recibe: pagina y, opcionalmente, propiedades
//-   propiedades -> [{ id, titulo, precio, ubicacion, imagen, publicado }]
//- Si no hay propiedades se muestra un estado vacío con la invitación a publicar.
block contenido
  - const propiedades = locals.propiedades || []

  //- Encabezado
  div(class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between")
    div
      p(class="mb-2 text-sm font-semibold uppercase tracking-[0.2em] text-terracota-500") Panel de administración
      h1(class="font-display text-4xl")= pagina
      p(class="mt-2 text-bosque-900/60") Administra las propiedades que has publicado.

    a(href="/propiedades/crear" class="group inline-flex items-center justify-center gap-2 rounded-full bg-bosque-900 px-6 py-3.5 font-semibold text-arena-50 transition hover:bg-bosque-800 focus:outline-none focus:ring-4 focus:ring-bosque-900/20")
      svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5" aria-hidden="true")
        path(d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z")
      | Publicar propiedad

  if propiedades.length
    //- Listado
    ul(class="mt-10 divide-y divide-arena-200 overflow-hidden rounded-2xl border border-arena-200 bg-white shadow-sm")
      each propiedad in propiedades
        li(class="flex flex-col gap-4 p-5 sm:flex-row sm:items-center")
          if propiedad.imagen
            img(src=`/uploads/${propiedad.imagen}` alt=propiedad.titulo class="h-40 w-full rounded-xl object-cover sm:size-24")
          else
            div(class="flex h-40 w-full items-center justify-center rounded-xl bg-arena-100 text-bosque-900/30 sm:size-24")
              svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-8" aria-hidden="true")
                path(stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955a1.126 1.126 0 0 1 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25")

          div(class="min-w-0 flex-1")
            div(class="flex flex-wrap items-center gap-2")
              h2(class="truncate font-display text-xl")= propiedad.titulo
              if propiedad.publicado
                span(class="rounded-full bg-bosque-50 px-2.5 py-0.5 text-xs font-semibold text-bosque-700") Publicada
              else
                span(class="rounded-full bg-arena-100 px-2.5 py-0.5 text-xs font-semibold text-bosque-900/60") Borrador
            if propiedad.ubicacion
              p(class="mt-1 truncate text-sm text-bosque-900/60")= propiedad.ubicacion
            if propiedad.precio
              p(class="mt-1 font-semibold text-terracota-600")= propiedad.precio

          div(class="flex gap-2 sm:shrink-0")
            a(href=`/propiedades/editar/${propiedad.id}` class="rounded-full border border-bosque-900/15 px-4 py-2 text-sm font-semibold text-bosque-900 transition hover:bg-arena-100") Editar
            form(method="POST" action=`/propiedades/eliminar/${propiedad.id}`)
              input(type="hidden" name="_csrf" value=locals.csrfToken)
              button(type="submit" class="cursor-pointer rounded-full border border-error-500/30 px-4 py-2 text-sm font-semibold text-error-600 transition hover:bg-error-50") Eliminar

  else
    //- Estado vacío
    div(class="mt-10 rounded-2xl border border-dashed border-arena-200 bg-white px-6 py-16 text-center")
      div(class="mx-auto flex size-16 items-center justify-center rounded-full bg-arena-100 text-terracota-500 ring-8 ring-arena-100/50")
        svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-8" aria-hidden="true")
          path(stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955a1.126 1.126 0 0 1 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25")

      h2(class="mt-8 font-display text-2xl") Aún no tienes propiedades
      p(class="mx-auto mt-2 max-w-sm text-bosque-900/60") Publica tu primera casa, departamento o terreno y aparecerá aquí.

      a(href="/propiedades/crear" class="group mt-8 inline-flex items-center justify-center gap-2 rounded-full bg-terracota-500 px-6 py-3.5 font-semibold text-white transition hover:bg-terracota-600 focus:outline-none focus:ring-4 focus:ring-terracota-500/20")
        | Publicar mi primera propiedad
        span(class="transition-transform group-hover:translate-x-1" aria-hidden="true") →
