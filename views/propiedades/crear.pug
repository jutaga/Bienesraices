extends ../layout/admin
include formulario

//- Formulario para publicar una propiedad (el formulario está en formulario.pug)
//- Recibe: pagina, csrfToken, categorias y precios (de la base de datos)
//-   categorias y precios -> registros de Sequelize con { id, nombre }
//- Si hubo errores al enviar: errores y datos (lo que escribió el usuario)
block contenido
  div(class="mx-auto max-w-3xl")
    a(href="/mis-propiedades" class="inline-flex items-center gap-1 text-sm font-medium text-bosque-900/60 hover:text-terracota-600")
      span(aria-hidden="true") ←
      | Volver a mis propiedades

    p(class="mt-6 mb-2 text-sm font-semibold uppercase tracking-[0.2em] text-terracota-500") Nueva publicación
    h1(class="font-display text-4xl")= pagina
    p(class="mt-2 text-bosque-900/60") Completa la información de tu propiedad para publicarla.

    +formularioPropiedad("/propiedades/crear", "Publicar propiedad")

block styles
  +estilosMapa()

block scripts
  +scriptsMapa()
